{
  "name": "@digitalwalletcorp/utils",
  "version": "0.2.0",
  "description": "A javascript utility.",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "require": {
        "types": "./lib/*.d.cts",
        "default": "./lib/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "yarn:dedupe": "npx yarn-deduplicate --strategy highest yarn.lock",
    "install:dev": "rm -rf lib dest && find node_modules -mindepth 1 -delete && yarn install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepack": "rm -rf lib && npm run build",
    "pack": "rm -rf dest && mkdir -p dest && npm pack --pack-destination=dest",
    "publish:npm": "bash ../bin/publish.sh",
    "test:unit": "vitest run --coverage"
  },
  "keywords": [
    "utils"
  ],
  "author": "satoshi kotaki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwalletcorp/utils.git"
  },
  "homepage": "https://github.com/digitalwalletcorp/utils",
  "bugs": {
    "url": "https://github.com/digitalwalletcorp/utils/issues"
  },
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "dependencies": {
    "big.js": "7.0.1",
    "crypto-js": "4.2.0",
    "diff": "8.0.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/big.js": "6.2.2",
    "@types/crypto-js": "4.2.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vite-plugin-dts": "5.1.0",
    "vitest": "3.2.4"
  },
  "resolutions": {
    "eslint": "10.11.0",
    "typescript-eslint": "8.71.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "globals": "17.13.0"
  }
}
